APP_ENV=local
SITE_NAME=My CMS
SITE_URL=http://cms.test

DB_HOST=localhost
DB_NAME=cms_db
DB_USER=root
DB_PASS=

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls
# Traza SMTP en el log (0 = apagado). Solo para diagnosticar: con adjuntos
# vuelca el mensaje entero y puede tumbar la respuesta bajo PHP-FPM.
SMTP_DEBUG=0
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=CMS
MAIL_ADMIN=admin@example.com
